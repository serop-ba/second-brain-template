{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 brain.py:*)",
      "Bash(python brain.py:*)"
    ],
    "deny": [
      "Read(./data/*.db)",
      "Edit(./data/*.db)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)"
    ],
    "ask": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(mv:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/brain.py\" context || python \"$CLAUDE_PROJECT_DIR/brain.py\" context",
            "timeout": 20,
            "statusMessage": "Loading the brain"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\"",
            "timeout": 10,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  }
}
